# This file is loaded automatically by local FastAPI runs. Deployment-provided
# environment variables take precedence. Do not commit a populated .env file.

# Optional public browser key for Mappls Web Maps JS.
# Create this key at https://auth.mappls.com/console and restrict it to the
# dashboard's production domain before setting it in the server environment.
MAPPLS_KEY=
CORS_ALLOW_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
LOG_LEVEL=INFO
APP_ENV=development
LIVE_OUTCOME_SCHEDULER_ENABLED=true
ALERT_DRY_RUN=true
ALERT_SCHEDULER_ENABLED=true
# Leave blank to use the project runtime database locally.
DATABASE_PATH=
ALERT_DATABASE_PATH=
PUBLIC_BASE_URL=http://localhost:8001
ALERT_FROM_EMAIL=alerts@example.com
ALERT_DAILY_CAP=2
# Optional: enables Open-Meteo's dedicated customer endpoint when a production
# key is available. Leave blank to use the public, non-commercial endpoint.
OPEN_METEO_API_KEY=
# Set either RESEND_API_KEY or SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD in production.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
